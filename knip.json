{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/client.tsx!",
    "src/server.ts!",
    "src/router.tsx!",
    "src/start.ts!",
    "src/routes/**/*.{ts,tsx}!",
    "src/features/*/index.ts!",
    "src/entities/*/index.ts!"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "tests/**/*.{ts,tsx}",
    "!src/generated/**",
    "!storybook-build/**",
    "!.output/**",
    "!node_modules/**"
  ],
  "ignore": [
    "src/generated/**",
    "src/vite-env.d.ts",
    "src/app/vite-dotenv-checker.plugin.ts",
    "src/app/strip-dangling-sourcemaps.plugin.ts",
    "src/shared/config/**",
    "src/shared/lib/sentry/**"
  ],
  "ignoreDependencies": ["daisyui"],
  "ignoreBinaries": [],
  "ignoreExportsUsedInFile": true,
  "paths": {
    "@generated/*": ["./src/generated/*"],
    "@pages/*": ["./src/pages/*"],
    "@shared/*": ["./src/shared/*"],
    "@widgets/*": ["./src/widgets/*"],
    "@features/*": ["./src/features/*"],
    "@entities/*": ["./src/entities/*"],
    "@public/*": ["./public/*"]
  }
}
