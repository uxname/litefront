{
  "name": "litefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "____________________BUILD AND RUN______________________________________": "",
    "build": "npm run build:vite && npx run-p check",
    "build:vite": "vite build",
    "start:dev": "vite",
    "start:prod": "node .output/server/index.mjs",
    "docker:build": "docker build -t \"${IMAGE_REGISTRY:-}litefront:${IMAGE_TAG:-latest}\" .",
    "docker:push": "if [ -z \"$IMAGE_REGISTRY\" ]; then echo 'set IMAGE_REGISTRY (e.g. ghcr.io/acme/) before pushing' >&2; exit 1; fi; docker push \"${IMAGE_REGISTRY}litefront:${IMAGE_TAG:-latest}\"",
    "compose:check": "docker compose -f docker-compose.prod.yml config -q",
    "____________________TESTING___________________________________________": "",
    "test:dev": "vitest",
    "test:prod": "vitest run",
    "test:e2e:dev": "playwright test --ui",
    "test:e2e:prod": "playwright test --project=chromium --reporter=list",
    "test:e2e:logs": "playwright test agent-logs --project=chromium --reporter=list",
    "test:e2e:screens": "playwright test agent-screens --project=chromium --reporter=list",
    "test:cov": "vitest run --coverage",
    "test:all": "npm run test:prod && npm run test:e2e:prod",
    "test:e2e:show-trace": "playwright show-trace",
    "____________________STORYBOOK__________________________________________": "",
    "storybook:serve": "ladle serve",
    "storybook:build": "ladle build",
    "storybook:preview": "ladle preview",
    "____________________CODEGEN____________________________________________": "",
    "gen": "graphql-codegen --require dotenv/config --config codegen.yml",
    "test:e2e:record": "npx playwright codegen",
    "____________________LINTING AND FORMATTING_____________________________": "",
    "lint": "biome check",
    "lint:fsd": "steiger ./src",
    "lint:fix": "biome check --write",
    "lint:fix:unsafe": "biome check --write --unsafe",
    "lint:style": "stylelint \"**/*.{css,scss}\"",
    "lint:style:fix": "npm run lint:style -- --fix",
    "ts:check": "tsc --noEmit",
    "check": "npx run-p lint:style ts:check lint:fix knip lint:fsd trio",
    "trio": "node scripts/check-component-trio.mjs",
    "knip": "knip --production",
    "____________________VERIFICATION (HOOKS CALL THESE)____________________": "",
    "secrets": "bash -c 'if command -v gitleaks >/dev/null 2>&1; then gitleaks detect --source . -v --no-banner; else echo \"⚠️  gitleaks not installed; skipping secrets scan.\"; fi'",
    "verify:commit": "npm run check && npm run secrets",
    "verify:push": "npm run verify:commit && npm run test:cov && npm run test:e2e:prod && npm run storybook:build && npx rimraf storybook-build",
    "____________________OTHER______________________________________________": "",
    "postinstall": "npm run prepare",
    "prepare": "npx lefthook install || true",
    "update": "npx ncu -u && npx rimraf node_modules package-lock.json && npm i",
    "postupdate": "npm run lint:fix && npm run check"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@sentry/node": "^10.68.0",
    "@sentry/react": "^10.68.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "@tanstack/router-devtools": "^1.167.0",
    "@urql/exchange-graphcache": "^9.0.1",
    "@urql/exchange-retry": "^2.0.0",
    "lucide-react": "^1.27.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "^7.83.0",
    "react-oidc-context": "^3.3.1",
    "react-scan": "^0.5.7",
    "sonner": "^2.0.7",
    "urql": "^5.0.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/schema-ast": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.2",
    "@graphql-codegen/typescript-urql": "^5.0.1",
    "@inlang/paraglide-js": "2.23.0",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.62.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "daisyui": "^5.7.4",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.2",
    "jsdom": "^30.0.0",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "npm-check-updates": "^22.2.9",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "steiger": "^0.6.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "stylelint-scss": "^7.2.0",
    "svgo": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  }
}
