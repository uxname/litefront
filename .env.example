# Application Configurations
#
# Every VITE_* value below is a RUNTIME value unless marked BUILD-TIME: the
# server reads it from its environment at boot (src/shared/config/env.ts), so
# one built image runs in any environment and this file is a copy-me template
# for `.env`, never something the image is built against. Missing a required
# one (VITE_OIDC_AUTHORITY, VITE_OIDC_CLIENT_ID, VITE_OIDC_REDIRECT_URI,
# VITE_OIDC_SCOPE, VITE_GRAPHQL_API_URL) stops the server at startup with the
# variable's name — and stops `docker compose -f docker-compose.prod.yml
# config` even earlier.
#
# HOST port for the dev docker-compose.yml only; inside the container the
# server always listens on 3000, and the prod compose publishes no host port at
# all (the reverse proxy reaches the container over the proxy network).
PORT=3000
# Docker image naming: registry prefix WITH trailing slash (e.g. ghcr.io/acme/);
# used by docker-compose.yml and `npm run docker:build` / `npm run docker:push`.
#IMAGE_REGISTRY=ghcr.io/acme/
#IMAGE_TAG=latest
# Name of the EXTERNAL network the reverse proxy already runs on; the prod
# compose joins it instead of publishing a port (docker-compose.prod.yml).
#PROXY_NETWORK=dokploy-network
VITE_BASE_URL=http://localhost:3000
# Point this at the liteend backend GraphQL endpoint.
VITE_GRAPHQL_API_URL=http://localhost:4000/graphql

# OIDC Configuration
# NOTE: the authority + client_id below are INTENTIONALLY hardcoded to a shared dev Logto
# tenant so the boilerplate authenticates out of the box. These are PUBLIC OIDC identifiers,
# not secrets: a SPA uses PKCE (no client_secret) and the client_id is already exposed in the
# browser's auth request. Swap them for your own tenant in a real project. Real secrets live
# in `.env` (gitignored), never here.
VITE_OIDC_AUTHORITY=https://auth.uxna.me/oidc
VITE_OIDC_CLIENT_ID=gdwtltuj70l6wo3k9rui1
VITE_OIDC_REDIRECT_URI=http://localhost:3000/callback
VITE_OIDC_SCOPE='openid profile offline_access'
# Logto API resource indicator — access_token is requested for this resource so its
# `aud` matches the backend's OIDC_AUDIENCE. Register the resource in Logto Console.
VITE_OIDC_API_RESOURCE=http://localhost:4000

# Sentry Configuration
VITE_SENTRY_DSN=
# The three below are BUILD-TIME (source-map upload while building; the auth
# token is a real secret and must never reach a container). Keep them empty here
# and set them in the build environment only.
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
VITE_SENTRY_AUTH_TOKEN=

# Mock / Dev
# BUILD-TIME on purpose: mock auth must not be flippable on a running container.
VITE_MOCK_AUTH=false
VITE_APP_VERSION=development
